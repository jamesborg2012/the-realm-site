# Copy to .env and adjust as needed:  cp .env.example .env
# .env is gitignored — keep real secrets out of version control.

# --- Database -------------------------------------------------------------
MYSQL_DATABASE=the_realm
MYSQL_USER=wp
MYSQL_PASSWORD=wp
MYSQL_ROOT_PASSWORD=root
# Table prefix — must match the imported dump (prod uses cki_, not wp_).
WP_TABLE_PREFIX=cki_

# --- WordPress site -------------------------------------------------------
# Add this line to /etc/hosts so the domain resolves locally:
#   127.0.0.1   local.therealmmalta.com
WP_URL=http://local.therealmmalta.com
# Production URL stored in the imported DB dump — rewritten to WP_URL on setup.
PROD_URL=https://therealmmalta.com
WP_TITLE=The Realm Malta (Local)
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=jamesborg2012@gmail.com

# --- Host port mappings ---------------------------------------------------
# WP_PORT=80 gives a clean URL (no :port suffix). If host port 80 is taken
# (e.g. XAMPP/Apache is running), either stop it or set WP_PORT=8080 and use
# WP_URL=http://local.therealmmalta.com:8080 instead.
WP_PORT=80
PMA_PORT=8081
